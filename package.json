{
  "name": "piphony",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:core && npm run build:web && npm run build:extension",
    "build:core": "tsc -p tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:extension": "vite build --config apps/extension/vite.config.ts",
    "typecheck": "npm run typecheck:core && npm run typecheck:web && npm run typecheck:extension",
    "typecheck:core": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck:extension": "tsc -p apps/extension/tsconfig.json --noEmit",
    "test": "vitest run",
    "web:dev": "vite --config apps/web/vite.config.ts --host 0.0.0.0 --port 3333 --strictPort",
    "web:preview": "vite preview --config apps/web/vite.config.ts --host 0.0.0.0 --port 3333",
    "dev:stack": "tsx src/cli/dev-stack.ts",
    "onboard": "tsx src/cli/onboard.ts",
    "status": "tsx src/cli/status.ts",
    "tracker:local": "tsx src/cli/tracker-local.ts",
    "orchestrator:watch": "tsx src/cli/orchestrator-watch.ts",
    "smoke": "tsx src/smoke/index.ts",
    "smoke:tracker-local": "tsx src/smoke/tracker-local.ts",
    "smoke:orchestrator": "tsx src/smoke/orchestrator.ts",
    "smoke:pi": "tsx src/smoke/pi.ts",
    "smoke:local-e2e": "tsx src/smoke/local-e2e.ts",
    "smoke:docker": "tsx src/smoke/docker-openclawsseum.ts",
    "smoke:restart": "tsx src/smoke/restart.ts",
    "smoke:observability": "tsx src/smoke/observability.ts",
    "smoke:session-control": "tsx src/smoke/session-control.ts",
    "smoke:cos": "tsx src/smoke/cos-actor.ts",
    "smoke:web": "tsx src/smoke/web-ui.ts",
    "smoke:stack": "tsx src/smoke/stack-ui.ts",
    "smoke:tracker-live:linear": "tsx src/smoke/tracker-provider-live.ts linear",
    "smoke:tracker-live:jira": "tsx src/smoke/tracker-provider-live.ts jira",
    "smoke:pull-based-workflow": "tsx src/smoke/pull-based-workflow.ts",
    "validate:deterministic": "tsx src/validation/run.ts deterministic",
    "validate:live": "tsx src/validation/run.ts live",
    "validate:main": "npm run validate:deterministic && npm run validate:live",
    "smoke:all": "npm run smoke:tracker-local && npm run smoke:orchestrator && npm run smoke:pi && npm run smoke:local-e2e && npm run smoke:docker && npm run smoke:restart && npm run smoke:observability && npm run smoke:pull-based-workflow && npm run smoke:web && npm run smoke:session-control && npm run smoke:cos && npm run smoke:stack",
    "ship:openclawsseum": "tsx src/smoke/ship-feature-openclawsseum.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@mariozechner/pi-ai": "latest",
    "@mariozechner/pi-coding-agent": "latest",
    "@sinclair/typebox": "^0.34.38",
    "@tanstack/react-devtools": "^0.7.11",
    "@tanstack/react-query": "^5.80.10",
    "@tanstack/react-query-devtools": "^5.80.10",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "brave-search": "^0.9.0",
    "hono": "^4.12.7",
    "lucide-react": "^0.511.0",
    "nitro": "npm:nitro-nightly@latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rivetkit": "^2.1.6",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.29",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.58.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.7",
    "vitest": "^3.1.2"
  }
}
